# Dictionary example using keys(), get(), values(), and items()

student = {
    "name": "Ishan",
    "age": 18,
    "grade": "A",
    "city": "Delhi"
}

# keys() -> returns all keys
print("Keys:", student.keys())
print("List of keys:", list(student.keys()))

# get() -> returns the value of a key, or default if the key is not found
print("Name:", student.get("name"))
print("Phone:", student.get("phone", "Not found"))

# values() -> returns all values
print("Values:", student.values())
print("List of values:", list(student.values()))

# items() -> returns key-value pairs as tuples
print("Items:", student.items())
print("List of items:", list(student.items()))

