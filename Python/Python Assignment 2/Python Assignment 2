    print("a is largest")
elif b > a and b > c:
    print("b is largest")
elif a == b and a == c:
    print("All numbers are equal")
elif a == b and a > c:
    print("a and b are equal and largest")
elif a == c and a > b:
    print("a and c are equal and largest")
elif b == c and b > a:
    print("b and c are equal and largest")
elif a == b and a < c:
